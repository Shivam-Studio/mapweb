# GitHub Git LFS storage for MapMotion Studio map assets
MAPMOTION_GITHUB_OWNER=Shivam-Studio
MAPMOTION_GITHUB_USERNAME=your-github-username
MAPMOTION_GITHUB_REPO=mapweb
MAPMOTION_GITHUB_BRANCH=main
MAPMOTION_GITHUB_TOKEN=replace-with-a-fine-grained-token
MAPMOTION_UPLOAD_KEY=replace-with-a-long-random-admin-upload-key
# Default 2000 MB (conservative default below the GitHub Free/Pro 2 GB per-file maximum). Use 4000 for Team or 5000 for Enterprise Cloud.
MAPMOTION_MAX_LFS_FILE_MB=2000
